# Telegram Bot Configuration
# Create a bot via @BotFather on Telegram and get the token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Channel Configuration
# Channel ID or username (e.g., @yourchannel or -1001234567890)
TELEGRAM_CHANNEL_ID=@yourchannel

# Telegram User Bot Configuration (Optional)
# For advanced user authentication - get from https://my.telegram.org/apps
TELEGRAM_USER_BOT_API_ID=your_api_id_here
TELEGRAM_USER_BOT_API_HASH=your_api_hash_here
TELEGRAM_USER_BOT_PHONE=your_phone_number_here
TELEGRAM_USER_BOT_CHAT_USERNAME=target_chat_username
TELEGRAM_USER_BOT_CHAT_ID=target_chat_id

# VK Configuration
# Create an app at https://vk.com/dev and get access token
VK_ACCESS_TOKEN=your_vk_access_token_here

# VK Owner ID (supports both groups and personal pages)
# For groups: use negative group ID (e.g., -123456789)
# For personal pages: use positive user ID (e.g., 123456789)
VK_OWNER_ID=-123456789

# X.com Configuration
# Create an app at https://developer.twitter.com/en/portal/dashboard
# Configure ONE of the modes below. Optional: X_AUTH_MODE=oauth2|oauth1|app|auto (default auto)
# Automatic priority: complete OAuth 1.0a > OAuth 2.0 user token > app-only bearer token

# OAuth 2.0 User Context: an already-issued user access token
# (scopes: tweet.read tweet.write users.read). No access token secret exists for OAuth 2.0.
X_OAUTH2_ACCESS_TOKEN=your_x_oauth2_user_access_token_here
# X_CLIENT_ID / X_CLIENT_SECRET are only used to obtain/refresh OAuth 2.0 tokens; they are not needed to post.
# X_CLIENT_ID=your_x_client_id_here
# X_CLIENT_SECRET=your_x_client_secret_here

# OAuth 1.0a User Context: all four values are required
# X_API_KEY=your_x_api_key_here
# X_API_KEY_SECRET=your_x_api_key_secret_here
# X_ACCESS_TOKEN=your_x_access_token_here
# X_ACCESS_TOKEN_SECRET=your_x_access_token_secret_here

# App-only Bearer Token: READ-ONLY, can never post or delete tweets
# X_BEARER_TOKEN=your_x_bearer_token_here

# Optional: Logging level (debug, info, warn, error)
LOG_LEVEL=info